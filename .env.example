# Settings for compose.yaml: copy this to .env and fill it in (docs/docker.md).

# The address other people's Puddles reach you at: a domain name or public IP, and the port forwarded to this machine.
PUDDLE_ADVERTISE=home.example.org:8443

# Your name, for a first profile ("main") made on the first start. Leave it empty to make profiles yourself later.
PUDDLE_NAME=

# Which build: the newest release (latest), a version (0.1.0), or the newest build of the dev branch (dev).
PUDDLE_IMAGE=ghcr.io/ezp2p/puddle:latest

# The port, TCP and UDP (8443 unless you change it).
PUDDLE_PORT=8443
